# Wildwood - Unity .gitignore
# Folders Unity regenerates on its own (huge, never commit these)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Meta files must always be committed, except for ignored assets
!/[Aa]ssets/**/*.meta

# Rider / Visual Studio / VS Code
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity crash/temp output
*.tmp
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# Builds and exported packages
*.apk
*.aab
*.app
*.exe
*.unitypackage
*.unitypackage.meta
ExportedObj/

# Addressables build output
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
